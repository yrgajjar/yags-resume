# ---------------------------------------------------------------------------
# Firebase web configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" and paste the values from your Firebase project:
#   Firebase Console -> Project settings -> General -> "Your apps" -> Web app
#   -> "SDK setup and configuration" -> Config
#
# These values are *public* client config (they ship in the browser bundle).
# They are NOT secrets. Access is protected by Firestore Security Rules and
# Firebase Authentication, not by hiding these keys.
#
# If you leave these blank, the public resume still renders using the bundled
# seed data, but the admin panel (login + saving) will be disabled.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Analytics for Firebase
VITE_FIREBASE_MEASUREMENT_ID=
